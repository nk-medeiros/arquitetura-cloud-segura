0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vpn" target="rdsA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="464"/><mxPoint x="440" y="599"/></Array></mxGeometry></mxCell><mxCell id="rep" value="replicação síncrona Multi-AZ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#1565C0;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rdsA" target="rdsB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#C62828;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#C62828;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="blocked"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="84" y="385"/></Array></mxGeometry></mxCell><mxCell id="elog" value="Flow Logs / eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#757575;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#757575;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vpc" target="ctnLog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Seta verde = fluxo permitido (o número é a linha da tabela em fluxos.md)&lt;br&gt;Seta vermelha tracejada = fluxo bloqueado&lt;br&gt;Seta azul tracejada = replicação do banco&lt;br&gt;Seta cinza tracejada = logs e auditoria&lt;br&gt;Sub-rede verde = pública | Sub-rede azul = privada&lt;br&gt;Públicas: apenas ALB e NAT Gateway. Privadas: aplicação e banco." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="200" y="810" width="700" height="130" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Observações&lt;/b&gt;&lt;br&gt;• Fluxos 5 e 6: App → Secrets Manager e CloudWatch Logs por HTTPS 443 (via NAT ou VPC endpoints de interface).&lt;br&gt;• Fluxo 4: o Gateway Endpoint do S3 fica nas route tables das duas sub-redes de app; a bucket policy só aceita o endpoint (aws:SourceVpce).&lt;br&gt;• Security Groups encadeados: sg-alb (443 de 0.0.0.0/0) → sg-app (8080 de sg-alb; 22 de sg-vpn) → sg-rds (5432 de sg-app e sg-vpn).&lt;br&gt;• Bloqueados: 11 Internet→App, 12 Internet→RDS, 13 Internet→SSH/RDP, 14 S3 público (Block Public Access), 15 RDS→Internet.&lt;br&gt;• IAM: a App usa IAM Role (instance profile) com s3:GetObject/PutObject só no bucket e GetSecretValue só no segredo do banco." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="810" width="780" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>